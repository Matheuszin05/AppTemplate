<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.avaliacao.AvaliacaoActivity">

    <!-- Adicionando um ScrollView para comportar conteúdos extensos -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Título: Avaliação do Serviço -->
            <TextView
                android:id="@+id/textViewTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Avaliação do Serviço"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginBottom="16dp" />

            <!-- RatingBar para avaliação do serviço -->
            <RatingBar
                android:id="@+id/ratingBarService"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:numStars="5"
                android:rating="0"
                android:stepSize="0.5"
                app:layout_constraintTop_toBottomOf="@id/textViewTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="16dp" />

            <!-- Título: Avaliação do Funcionário -->
            <TextView
                android:id="@+id/textViewEmployeeRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Avaliação do Funcionário"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/ratingBarService"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="24dp" />

            <!-- RatingBar para avaliação do funcionário -->
            <RatingBar
                android:id="@+id/ratingBarEmployee"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:numStars="5"
                android:rating="0"
                android:stepSize="1"
                app:layout_constraintTop_toBottomOf="@id/textViewEmployeeRating"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="16dp" />

            <!-- Título: Comentário -->
            <TextView
                android:id="@+id/textViewComment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Comentário:"
                android:textColor="#000000"
                android:textSize="16sp"
                app:layout_constraintTop_toBottomOf="@id/ratingBarEmployee"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="16dp" />

            <!-- EditText para o comentário -->
            <EditText
                android:id="@+id/editTextComment"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:hint="Escreva seu comentário aqui..."
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="5"
                android:gravity="top|start"
                android:padding="8dp"
                android:textColor="#000000"
                android:textColorHint="#888888"
                android:background="@drawable/edittext_background"
                app:layout_constraintTop_toBottomOf="@id/textViewComment"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="8dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:focusableInTouchMode="true" />

            <!-- Botão de envio -->
            <Button
                android:id="@+id/buttonSubmitRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/black"
                android:text="Enviar Avaliação"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_background"
                app:layout_constraintTop_toBottomOf="@id/editTextComment"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="24dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
